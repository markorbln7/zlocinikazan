{%- liquid
  assign s = section.settings
-%}

<div class="zik">
  <div class="zik-zigzag">
    {%- for block in section.blocks -%}
      {%- liquid
        assign bs = block.settings

        # Alternate the column order: text first, then image first, then text first…
        assign reverse = false
        assign position = forloop.index0 | modulo: 2
        if position == 1
          assign reverse = true
        endif

        assign product = bs.product
        assign variant = product.selected_or_first_available_variant
        assign form_id = 'ZikZigzagForm-' | append: section.id | append: '-' | append: block.id
      -%}

      {%- capture image_html -%}
        <div class="zik-zigzag__image">
          {%- if bs.image != blank -%}
            {{
              bs.image
              | image_url: width: 1400
              | image_tag:
                widths: '400, 600, 800, 1000, 1400',
                sizes: '(min-width: 768px) 40vw, 100vw',
                alt: bs.image.alt,
                loading: 'lazy'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
      {%- endcapture -%}

      <div
        class="zik-zigzag__block{% if reverse %} zik-zigzag__block--reverse{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if reverse -%}{{ image_html }}{%- endif -%}

        <div class="zik-zigzag__text">
          {%- if bs.heading != blank -%}
            <div class="zik-zigzag__heading z-h2 z-mono-medium">{{ bs.heading }}</div>
          {%- endif -%}

          {%- if bs.text != blank -%}
            <div class="zik-zigzag__body z-p-large z-mono-regular">{{ bs.text }}</div>
          {%- endif -%}

          {%- if product != blank -%}
            <product-form-component
              data-section-id="{{ section.id }}"
              data-product-id="{{ product.id }}"
              data-product-url="{{ product.url }}"
              on:submit="/handleSubmit"
              data-quantity-default="1"
              data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
            >
              <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>

              {%- form 'product', product, id: form_id -%}
                <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">

                <add-to-cart-component ref="addToCartButtonContainer">
                  <button
                    type="submit"
                    name="add"
                    ref="addToCartButton"
                    class="homeProduct__inner--content__button zik-zigzag__button z-mono-regular"
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {% if variant.available %}{{ s.button_label }}{% else %}{{ s.sold_out_label }}{% endif %}
                  </button>
                </add-to-cart-component>
              {%- endform -%}
            </product-form-component>

          {%- elsif bs.button_label != blank -%}
            <a
              href="{{ bs.button_link | default: '#' }}"
              class="homeProduct__inner--content__button zik-zigzag__button z-mono-regular"
            >
              {{- bs.button_label -}}
            </a>
          {%- endif -%}
        </div>

        {%- unless reverse -%}{{ image_html }}{%- endunless -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "ZiK tekst i slika",
  "tag": "section",
  "class": "zik-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Tekst dugmeta za korpu",
      "default": "DODAJ U KORPU +"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Tekst kada nema na stanju",
      "default": "NEMA NA STANJU"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Red",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Naslov",
          "default": "Punoća ukusa"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slika"
        },
        {
          "type": "header",
          "content": "Dugme"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Proizvod",
          "info": "Ako se izabere, dugme dodaje proizvod u korpu."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Tekst linka",
          "info": "Koristi se samo ako proizvod nije izabran."
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZiK tekst i slika",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
