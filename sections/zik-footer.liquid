{%- comment -%}
  Dark footer: logo, contact details, socials, link columns and copyright.

  The footer image, newsletter and Instagram grid live in their own sections
  (zik-footer-newsletter, zik-instagram) so app sections can be placed between
  them and this one.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

<div class="zik">
  <div class="footer">
    <div class="footer__wrapper">
      <div class="footer__middle zik-container">
        <div class="footer__middle--left">
          <div class="footer__middle--left__logo">
            {%- if s.logo != blank -%}
              {{
                s.logo
                | image_url: width: 880
                | image_tag:
                  widths: '220, 440, 660, 880',
                  sizes: '440px',
                  alt: shop.name,
                  loading: 'lazy'
              }}
            {%- else -%}
              <span class="footer__middle--left__logo-text z-mono-medium">{{ shop.name }}</span>
            {%- endif -%}
          </div>

          <div class="footer__middle--left__text">
            {%- if s.contact_title != blank -%}
              <div class="footer__middle--left__text--title z-left z-p-large z-white z-mono-medium">
                {{ s.contact_title }}
              </div>
            {%- endif -%}

            {%- if s.address != blank -%}
              <div class="footer__middle--left__text--address z-mono-regular z-p">{{ s.address }}</div>
            {%- endif -%}

            {%- if s.phone != blank -%}
              <div class="footer__middle--left__text--address z-mono-regular z-p">
                <a href="tel:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a>
              </div>
            {%- endif -%}

            {%- if s.email != blank -%}
              <div class="footer__middle--left__text--address z-mono-regular z-p">
                <a href="mailto:{{ s.email }}">{{ s.email | upcase }}</a>
              </div>
            {%- endif -%}
          </div>

          <div class="footer__middle--left__socials">
            {%- if s.instagram_url != blank -%}
              <a href="{{ s.instagram_url }}" target="_blank" rel="noopener" class="footer__middle--left__socials--single" aria-label="Instagram">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38C1.36 2.67.95 3.34.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.47 1.38 2.13.66.66 1.33 1.07 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.8-.31 1.47-.72 2.13-1.38.66-.66 1.07-1.33 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.31-.8-.72-1.47-1.38-2.13-.66-.66-1.33-1.07-2.13-1.38-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0z"/><path d="M12 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zm0 10.16a4 4 0 110-8 4 4 0 010 8z"/><circle cx="18.41" cy="5.59" r="1.44"/></svg>
              </a>
            {%- endif -%}

            {%- if s.facebook_url != blank -%}
              <a href="{{ s.facebook_url }}" target="_blank" rel="noopener" class="footer__middle--left__socials--single" aria-label="Facebook">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z"/></svg>
              </a>
            {%- endif -%}

            {%- if s.twitter_url != blank -%}
              <a href="{{ s.twitter_url }}" target="_blank" rel="noopener" class="footer__middle--left__socials--single" aria-label="X">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.25 6.93zm-1.29 19.5h2.04L6.49 3.24H4.3z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>

        <div class="footer__middle--right">
          {%- for block in section.blocks -%}
            <div class="footer__middle--right__single" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <div class="footer__middle--right__single--title z-white z-p-large z-mono-medium">
                  {{ block.settings.title }}
                </div>
              {%- endif -%}

              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}" class="footer__middle--right__single--link z-white z-p z-mono-regular">
                  {{- link.title -}}
                </a>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="footer__bottom z-mono-regular z-center z-white z-p-smaller">
      {{ s.copyright }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ZiK footer",
  "tag": "footer",
  "class": "zik-footer-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Koristite svetlu verziju logotipa — pozadina je tamna."
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Naslov kontakta",
      "default": "KONTAKTIRAJTE NAS"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Adresa",
      "default": "ZLOČIN I KAZAN, METOHIJSKA 24, BEOGRAD"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefon",
      "default": "+381641815117"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@zlocinikazan.rs"
    },
    {
      "type": "header",
      "content": "Društvene mreže"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter"
    },
    {
      "type": "header",
      "content": "Dno"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "Autorska prava © 2025 Zločin i kazan. Sva prava zadržana"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Kolona linkova",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Naslov",
          "default": "SAJT"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Meni",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
