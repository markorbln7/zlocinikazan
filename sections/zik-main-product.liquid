{%- comment -%}
  Product detail page.

  Ports single-product.php. Note the field order differs from the homepage
  product section: title -> price -> quantity -> button -> description -> tags.

  No gallery or slider by design. The first product image is the main image;
  the second, if present, renders full width beneath the section.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = product.selected_or_first_available_variant

  assign main_image = product.images[0]
  assign secondary_image = product.images[1]
  assign main_alt = main_image.alt | default: product.title
  assign secondary_alt = secondary_image.alt | default: product.title

  assign can_add_to_cart = false
  assign button_label = s.sold_out_label
  if variant != blank and variant.available
    assign can_add_to_cart = true
    assign button_label = s.button_label
  endif

  assign product_form_id = 'ZikProductForm-' | append: section.id

  assign variant_media = variant.featured_media.preview_image | image_url: width: 100
  if variant.featured_media.preview_image == blank
    assign variant_media = product.featured_media.preview_image | image_url: width: 100
  endif
-%}

<div class="zik">
  <div class="product__single">
    <section class="homeProduct">
      <div class="homeProduct__inner">
        <div class="homeProduct__inner--image">
          {%- if main_image != blank -%}
            {{
              main_image
              | image_url: width: 1600
              | image_tag:
                widths: '400, 600, 800, 1200, 1600',
                sizes: '(min-width: 1025px) 40vw, 100vw',
                alt: main_alt,
                loading: 'eager',
                fetchpriority: 'high'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        <div class="homeProduct__inner--content">
          <div class="homeProduct__inner--content__title z-h2 z-mono-medium">{{ product.title }}</div>

          <div class="homeProduct__inner--content__price z-h2 z-mono-medium">
            <div class="zik-price-row">
              <div class="z-h2 z-mono-medium" ref="zikPrice" data-zik-price>{{ variant.price | money }}</div>
              {%- if variant.compare_at_price > variant.price -%}
                <div class="z-h2 z-mono-medium zik-price-compare">{{ variant.compare_at_price | money }}</div>
              {%- endif -%}
            </div>
          </div>

          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ product.id }}"
            data-product-url="{{ product.url }}"
            on:submit="/handleSubmit"
            data-quantity-default="{{ variant.quantity_rule.min | default: 1 }}"
            data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
          >
            <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>

            {%- form 'product', product, id: product_form_id, class: 'zik-product-form' -%}
              {%- if product.has_only_default_variant -%}
                <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
              {%- else -%}
                <div class="product__single--variants z-p z-mono-regular">
                  <label for="ZikVariant-{{ section.id }}">{{ s.variant_label }}</label>
                  <select
                    id="ZikVariant-{{ section.id }}"
                    name="id"
                    ref="variantId"
                    data-zik-variant-select
                  >
                    {%- for v in product.variants -%}
                      <option
                        value="{{ v.id }}"
                        data-price="{{ v.price | money | escape }}"
                        data-available="{{ v.available }}"
                        {% if v.id == variant.id %}selected{% endif %}
                        {% unless v.available %}disabled{% endunless %}
                      >
                        {{ v.title }}{% unless v.available %} — {{ s.sold_out_label }}{% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}

              <div class="homeProduct__inner--content__quantity">
                <div class="homeProduct__inner--content__quantity--title z-p z-mono-regular">
                  {{ s.quantity_label }}
                </div>

                <quantity-selector-component
                  class="homeProduct__inner--content__quantity--wrapper z-p z-mono-regular"
                  ref="quantitySelector"
                  data-variant-id="{{ variant.id }}"
                >
                  <button
                    class="homeProduct__inner--content__quantity--wrapper__minus"
                    type="button"
                    name="minus"
                    on:click="/decreaseQuantity"
                    ref="minusButton"
                    aria-label="{{ 'accessibility.decrease_quantity' | t }}"
                  >
                    &minus;
                  </button>
                  <input
                    class="homeProduct__inner--content__quantity--wrapper__number"
                    type="number"
                    name="quantity"
                    value="{{ variant.quantity_rule.min | default: 1 }}"
                    min="{{ variant.quantity_rule.min | default: 1 }}"
                    data-min="{{ variant.quantity_rule.min | default: 1 }}"
                    data-cart-quantity="{{ cart | item_count_for_variant: variant.id }}"
                    {% if variant.quantity_rule.max %}
                      max="{{ variant.quantity_rule.max }}"
                    {% endif %}
                    step="{{ variant.quantity_rule.increment | default: 1 }}"
                    on:blur="/setQuantity"
                    on:focus="/selectInputValue"
                    ref="quantityInput"
                    aria-label="{{ 'accessibility.quantity' | t }}"
                  >
                  <button
                    class="homeProduct__inner--content__quantity--wrapper__plus"
                    type="button"
                    name="plus"
                    on:click="/increaseQuantity"
                    ref="plusButton"
                    aria-label="{{ 'accessibility.increase_quantity' | t }}"
                  >
                    +
                  </button>
                </quantity-selector-component>
              </div>

              <add-to-cart-component
                ref="addToCartButtonContainer"
                data-product-variant-media="{{ variant_media }}"
              >
                <button
                  type="submit"
                  name="add"
                  ref="addToCartButton"
                  class="homeProduct__inner--content__button z-mono-regular"
                  data-zik-atc
                  data-add-label="{{ s.button_label | escape }}"
                  data-sold-out-label="{{ s.sold_out_label | escape }}"
                  {% unless can_add_to_cart %}
                    disabled
                  {% endunless %}
                >
                  {{ button_label }}
                </button>
              </add-to-cart-component>
            {%- endform -%}
          </product-form-component>

          {%- if s.show_description and product.description != blank -%}
            <div class="homeProduct__inner--content__description z-p z-mono-regular">
              {{ product.description }}
            </div>
          {%- endif -%}

          {%- if s.show_tags and product.tags.size > 0 -%}
            <div class="homeProduct__inner--content__tags z-p-smaller z-mono-regular">
              {%- for tag in product.tags -%}{{ tag }} | {% endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </section>

    {%- if secondary_image != blank -%}
      <div class="product__single--image">
        {{
          secondary_image
          | image_url: width: 2800
          | image_tag:
            widths: '600, 900, 1200, 1600, 2000, 2400, 2800',
            sizes: '100vw',
            alt: secondary_alt,
            loading: 'lazy'
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{%- unless product.has_only_default_variant -%}
  <script>
    (function () {
      const root = document.currentScript.closest('.shopify-section') || document;
      const select = root.querySelector('[data-zik-variant-select]');
      const price = root.querySelector('[data-zik-price]');
      const button = root.querySelector('[data-zik-atc]');
      if (!select) return;

      select.addEventListener('change', () => {
        const option = select.selectedOptions[0];
        if (!option) return;

        if (price && option.dataset.price) price.textContent = option.dataset.price;

        if (button) {
          const available = option.dataset.available === 'true';
          button.disabled = !available;
          button.textContent = available ? button.dataset.addLabel : button.dataset.soldOutLabel;
        }

        const quantity = root.querySelector('quantity-selector-component');
        if (quantity) quantity.dataset.variantId = option.value;
      });
    })();
  </script>
{%- endunless -%}

{% schema %}
{
  "name": "ZiK proizvod PDP",
  "tag": "section",
  "class": "zik-main-product-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Glavna slika je prva slika proizvoda. Druga slika proizvoda se prikazuje preko cele širine ispod. Nema galerije ni slajdera."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Prikaži opis",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Prikaži tagove (sastojke)",
      "default": true
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Naziv polja za količinu",
      "default": "Količina"
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Naziv polja za varijantu",
      "default": "Varijanta"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Tekst dugmeta",
      "default": "DODAJ U KORPU +"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Tekst kada nema na stanju",
      "default": "NEMA NA STANJU"
    }
  ],
  "presets": []
}
{% endschema %}
