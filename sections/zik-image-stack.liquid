<div class="zik">
  <div class="images">
    {%- for block in section.blocks -%}
      <div class="images__single" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '600, 900, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 1025px) 80vw, 100vw',
              alt: block.settings.image.alt,
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "ZiK slike",
  "tag": "section",
  "class": "zik-section",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Slika",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slika"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZiK slike",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
