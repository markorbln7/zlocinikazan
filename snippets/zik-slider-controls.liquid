{%- doc -%}
  Prev/next arrows and the bullet container for a <zik-slider>.
  Bullets are generated by zik-slider.js from the real slide count.

  @param {string} [prev_label] - Accessible label for the previous arrow.
  @param {string} [next_label] - Accessible label for the next arrow.
{%- enddoc -%}

<button
  type="button"
  class="zik-slider__arrow zik-slider__arrow--prev"
  data-zik-prev
  aria-label="{{ prev_label | default: 'Prethodno' | escape }}"
>
  <svg viewBox="0 0 12 20" fill="none" aria-hidden="true" focusable="false">
    <path d="M11 1 2 10l9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>

<button
  type="button"
  class="zik-slider__arrow zik-slider__arrow--next"
  data-zik-next
  aria-label="{{ next_label | default: 'Sledeće' | escape }}"
>
  <svg viewBox="0 0 12 20" fill="none" aria-hidden="true" focusable="false">
    <path d="m1 1 9 9-9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>

<div class="zik-slider__bullets" data-zik-bullets></div>
